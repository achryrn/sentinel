<Window x:Class="Sentinel.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sentinel.Gui.Views"
        Title="Sentinel: Endpoint Security Scanner"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock Text="SENTINEL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="endpoint security scanner" FontSize="11" Foreground="{StaticResource DimTextBrush}"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,14"/>
                    <StackPanel x:Name="NavPanel">
                        <Button x:Name="NavDashboard" Content="Dashboard" Tag="dashboard" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavScan" Content="Scan" Tag="scan" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavThreats" Content="Threats" Tag="threats" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavProcesses" Content="Processes" Tag="processes" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavNetwork" Content="Network" Tag="network" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavMemory" Content="Memory" Tag="memory" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavPersistence" Content="Persistence" Tag="persistence" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavFiles" Content="Files" Tag="files" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavSystem" Content="System Security" Tag="system" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavEvents" Content="Events" Tag="events" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavQuarantine" Content="Quarantine" Tag="quarantine" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                        <Button x:Name="NavSettings" Content="Settings" Tag="settings" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" Width="188"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Border x:Name="ConnBadge" Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource BadBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnText" Text="Not connected" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" x:Name="ContentHost"/>
    </Grid>
</Window>
