<UserControl x:Class="Sentinel.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sentinel.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Dashboard"/>
            <TextBlock Text="Live posture summary. All data comes from the Sentinel service over the IPC pipe."
                       Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,16"/>

            <!-- Stat cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Findings" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="FindingsStat" Text="-" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="FindingsSub" Text="not loaded" Foreground="{StaticResource DimTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Quarantined" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="QuarantineStat" Text="-" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="QuarantineSub" Text="not loaded" Foreground="{StaticResource DimTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Realtime events" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="RealtimeStat" Text="-" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="RealtimeSub" Text="not loaded" Foreground="{StaticResource DimTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Service" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="ServiceStat" Text="-" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="ServiceSub" Text="not loaded" Foreground="{StaticResource DimTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System posture -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="System posture" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Defender" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="DefenderStat" Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Firewall" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="FirewallStat" Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UAC" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="UacStat" Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Last audit" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="AuditStat" Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Realtime event console -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Realtime event console" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                    <DataGrid x:Name="RealtimeGrid" Height="220" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, Converter={StaticResource UtcTimeConverter}}" Width="140"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="*"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
